        {
            "html": "<form action=\"http://api-manager.test/contact\" method=\"POST\" class=\"bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-8 sm:p-10 shadow-sm\" x-data=\"{ isAuthenticated: false, type: 'person', useSameEmail: false, validation: { name: false, company_name: false, email: false, contact_name: false, contact_email: false, subject: false, message: false }, validateEmail(email) { return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email); }, validateName(name, type) { if (!name || name.length < 3) return false; const max = type === 'company' ? 100 : 50; if (name.length > max) return false; if (type === 'company') { return /^[\\p{L}\\s\\-'0-9]+$/u.test(name); } return /^[\\p{L}\\s\\-']+$/u.test(name); }, validateSubject(subject) { return subject && subject.length >= 5 && subject.length <= 100; }, validateSubject(subject) { return subject && subject.length >= 5 && subject.length <= 100; }, validateMessage(message) { return message && message.length >= 10 && message.length <= 2000; } }\" spellcheck=\"false\" >\n<input type=\"hidden\" name=\"_token\" value=\"Hig9GQRCN83y0KpHqpEJcVN8Dl9yfcPpB9IXx1rC\" autocomplete=\"off\">\n<!-- Honeypot field (hidden from users) -->\n<input type=\"text\" name=\"website\" class=\"hidden\" tabindex=\"-1\" autocomplete=\"off\" >\n<!-- Timestamp field (hidden) -->\n<input type=\"hidden\" name=\"form_timestamp\" value=\"1776949780\">\n<!-- Language field (hidden) -->\n<input type=\"hidden\" name=\"language\" value=\"fr\">\n<!-- Type field (hidden for authenticated clients) -->\n<div class=\"mb-6\" bis_skin_checked=\"1\">\n<label class=\"block text-sm font-semibold text-gray-900 dark:text-white mb-3\"> Type de Compte \n<span class=\"text-red-500\">*</span>\n</label>\n<div class=\"space-y-3\" bis_skin_checked=\"1\">\n<label class=\"flex items-center gap-3 cursor-pointer\">\n<input type=\"radio\" name=\"type\" value=\"person\" x-model=\"type\" class=\"w-4 h-4 text-indigo-600 bg-gray-100 border-gray-300 rounded focus:ring-2 focus:ring-indigo-500 dark:focus:ring-indigo-600 dark:ring-offset-gray-800 dark:bg-gray-700 dark:border-gray-600\" required=\"\">\n<span class=\"text-gray-700 dark:text-gray-300\">Particulier</span>\n</label>\n<label class=\"flex items-center gap-3 cursor-pointer\">\n<input type=\"radio\" name=\"type\" value=\"company\" x-model=\"type\" class=\"w-4 h-4 text-indigo-600 bg-gray-100 border-gray-300 rounded focus:ring-2 focus:ring-indigo-500 dark:focus:ring-indigo-600 dark:ring-offset-gray-800 dark:bg-gray-700 dark:border-gray-600\" required=\"\">\n<span class=\"text-gray-700 dark:text-gray-300\">Entreprise</span>\n</label>\n</div>\n</div>\n<!-- Name Field (Person only) -->\n<div class=\"mb-6\" x-show=\"type === 'person'\" bis_skin_checked=\"1\" style=\"display: none;\">\n<div class=\"flex items-center justify-between mb-2\" bis_skin_checked=\"1\">\n<label for=\"name\" class=\"block text-sm font-semibold text-gray-900 dark:text-white\"> Votre Nom \n<span class=\"text-red-500\">*</span>\n</label>\n<span x-show=\"validation.name\" class=\"text-green-500 text-lg\">✓</span>\n</div>\n<input type=\"text\" id=\"name\" name=\"name\" @input=\"validation.name = validateName($el.value, 'person')\" class=\"w-full px-4 py-3 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg transition-all focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-900 placeholder-gray-500 dark:placeholder-gray-400 \" required=\"\" minlength=\"3\" maxlength=\"50\" placeholder=\"Jean Dupont\" spellcheck=\"false\" >\n</div>\n<!-- Company Name Field (Company only) -->\n<div class=\"mb-6\" x-show=\"type === 'company'\" bis_skin_checked=\"1\">\n<div class=\"flex items-center justify-between mb-2\" bis_skin_checked=\"1\">\n<label for=\"company_name\" class=\"block text-sm font-semibold text-gray-900 dark:text-white\"> Nom de l'Entreprise \n<span class=\"text-red-500\">*</span>\n</label>\n<span x-show=\"validation.company_name\" class=\"text-green-500 text-lg\">✓</span>\n</div>\n<input type=\"text\" id=\"company_name\" name=\"company_name\" @input=\"validation.company_name = validateName($el.value, 'company')\" class=\"w-full px-4 py-3 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg transition-all focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-900 placeholder-gray-500 dark:placeholder-gray-400 \" required=\"\" minlength=\"3\" maxlength=\"100\" placeholder=\"Acme SARL\" spellcheck=\"false\" >\n</div>\n<!-- Contact Person Field (Company only) -->\n<div class=\"mb-6\" x-show=\"type === 'company'\" bis_skin_checked=\"1\">\n<div class=\"flex items-center justify-between mb-2\" bis_skin_checked=\"1\">\n<label for=\"contact_name\" class=\"block text-sm font-semibold text-gray-900 dark:text-white\"> Personne de Contact </label>\n<span x-show=\"validation.contact_name\" class=\"text-green-500 text-lg\" style=\"display: none;\">✓</span>\n</div>\n<input type=\"text\" id=\"contact_name\" name=\"contact_name\" @input=\"validation.contact_name = $el.value.length === 0 || ($el.value.length >= 3 && /^[\\p{L}\\s\\-'0-9]+$/u.test($el.value))\" class=\"w-full px-4 py-3 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg transition-all focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-900 placeholder-gray-500 dark:placeholder-gray-400 \" minlength=\"3\" maxlength=\"100\" placeholder=\"Jean Dupont\" >\n</div>\n<!-- Email Field -->\n<div class=\"mb-6\" bis_skin_checked=\"1\">\n<div class=\"flex items-center justify-between mb-2\" bis_skin_checked=\"1\">\n<label for=\"email\" class=\"block text-sm font-semibold text-gray-900 dark:text-white\"> Votre Email \n<span class=\"text-red-500\">*</span>\n</label>\n<span x-show=\"validation.email\" class=\"text-green-500 text-lg\">✓</span>\n</div>\n<input type=\"email\" id=\"email\" name=\"email\" @input=\"validation.email = validateEmail($el.value)\" class=\"w-full px-4 py-3 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg transition-all focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-900 placeholder-gray-500 dark:placeholder-gray-400 \" required=\"\" placeholder=\"jean@example.com\" spellcheck=\"false\" >\n</div>\n<!-- Contact Email Checkbox (Company only) -->\n<div class=\"mb-6\" x-show=\"type === 'company'\" bis_skin_checked=\"1\">\n<label class=\"flex items-center gap-3 cursor-pointer\">\n<input type=\"checkbox\" x-model=\"useSameEmail\" class=\"w-4 h-4 text-indigo-600 bg-gray-100 border-gray-300 rounded focus:ring-2 focus:ring-indigo-500 dark:focus:ring-indigo-600 dark:ring-offset-gray-800 dark:bg-gray-700 dark:border-gray-600\">\n<span class=\"text-gray-700 dark:text-gray-300 text-sm\"> Utiliser le même email que l'email principal </span>\n</label>\n<input type=\"hidden\" name=\"use_same_email\" x-bind:value=\"useSameEmail ? 'on' : ''\">\n</div>\n<!-- Contact Email Field (Company only, if not using same email) -->\n<div class=\"mb-6\" x-show=\"type === 'company' && !useSameEmail\" bis_skin_checked=\"1\">\n<div class=\"flex items-center justify-between mb-2\" bis_skin_checked=\"1\">\n<label for=\"contact_email\" class=\"block text-sm font-semibold text-gray-900 dark:text-white\"> Email du Contact </label>\n<span x-show=\"validation.contact_email\" class=\"text-green-500 text-lg\">✓</span>\n</div>\n<input type=\"email\" id=\"contact_email\" name=\"contact_email\" @input=\"validation.contact_email = $el.value.length === 0 || validateEmail($el.value)\" class=\"w-full px-4 py-3 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg transition-all focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-900 placeholder-gray-500 dark:placeholder-gray-400 \" placeholder=\"contact@acme.com\" x-bind:required=\"!useSameEmail\" required=\"required\" spellcheck=\"false\" >\n</div>\n<!-- Subject Field -->\n<div class=\"mb-6\" bis_skin_checked=\"1\">\n<div class=\"flex items-center justify-between mb-2\" bis_skin_checked=\"1\">\n<label for=\"subject\" class=\"block text-sm font-semibold text-gray-900 dark:text-white\"> Sujet \n<span class=\"text-red-500\">*</span>\n</label>\n<span x-show=\"validation.subject\" class=\"text-green-500 text-lg\">✓</span>\n</div>\n<input type=\"text\" id=\"subject\" name=\"subject\" @input=\"validation.subject = validateSubject($el.value)\" class=\"w-full px-4 py-3 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg transition-all focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-900 placeholder-gray-500 dark:placeholder-gray-400 \" required=\"\" minlength=\"5\" maxlength=\"100\" placeholder=\"De quoi parle votre message ?\" spellcheck=\"false\" >\n</div>\n<!-- Message Field -->\n<div class=\"mb-6\" bis_skin_checked=\"1\">\n<div class=\"flex items-center justify-between mb-2\" bis_skin_checked=\"1\">\n<label for=\"message\" class=\"block text-sm font-semibold text-gray-900 dark:text-white\"> Message \n<span class=\"text-red-500\">*</span>\n</label>\n<span x-show=\"validation.message\" class=\"text-green-500 text-lg\">✓</span>\n</div>\n<textarea id=\"message\" name=\"message\" @input=\"validation.message = validateMessage($el.value)\" class=\"w-full px-4 py-3 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg transition-all focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:focus:ring-indigo-900 placeholder-gray-500 dark:placeholder-gray-400 \" required=\"\" minlength=\"10\" maxlength=\"2000\" rows=\"6\" placeholder=\"Dites-nous ce que vous en pensez...\" ></textarea>\n<p class=\"mt-2 text-xs text-gray-600 dark:text-gray-400\">Minimum 10 caractères, maximum 2000 caractères</p>\n</div>\n<!-- Submit Button -->\n<button type=\"submit\" class=\"w-full px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-base rounded-lg shadow-lg hover:shadow-xl transition-all duration-200 hover:-translate-y-0.5 cursor-pointer\" > Envoyer le Message </button>\n</form>",
